# Mapbox access token（https://account.mapbox.com/access-tokens/）
MAPBOX_ACCESS_TOKEN=pk.your_token_here

# 未传 category 时使用的默认分类（Mapbox canonical category id）
DEFAULT_POI_CATEGORY=restaurant
# 单次查询返回的 POI 数（Mapbox 上限 25）
POI_LIMIT=10
# /tracks/{id}/pois 单次请求最多调用 Mapbox 的次数
MAX_POI_QUERIES_PER_TRACK=20

# DeepSeek API key（https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=sk-your_key_here
DEEPSEEK_MODEL=deepseek-chat
# Week 2 run_tour 查询的地标类 Mapbox 分类（逗号分隔）
LANDMARK_CATEGORIES=museum,park,monument,historic_site,place_of_worship,university,theatre
